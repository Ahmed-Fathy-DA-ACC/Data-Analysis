/C [1 1 1]
/Contents (SET GLOBAL local_infile = 1;\nCREATE DATABASE IF NOT EXISTS amal;\nUSE amal;\n\nCREATE TABLE mytable \(\n    student_id INT PRIMARY KEY,\n    name VARCHAR\(100\),\n    grade VARCHAR\(20\),\n    age INT,\n    gender VARCHAR\(10\),\n    mathematics_score INT,\n    science_score INT,\n    english_score INT,\n    history_score INT,\n    geography_score INT,\n    art_score INT,\n    pe_score INT,\n    attendance_rate DECIMAL\(5,2\),\n    extracurricular_activities VARCHAR\(100\)\n\);\nLOAD DATA LOCAL INFILE 'C:/Desktop/Amal/students_dataset.csv'\nINTO TABLE mytable\nFIELDS TERMINATED BY ',' \nENCLOSED BY '"'\nLINES TERMINATED BY '\\n'\nIGNORE 1 ROWS;\nselect * from mytable;\n\n)
